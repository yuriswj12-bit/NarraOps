# API process (production should bind behind a reverse proxy)
API_HOST=127.0.0.1
API_PORT=5190
API_BODY_LIMIT_BYTES=9000000
LOG_LEVEL=info

# Async Agent runtime and SSE
AGENT_MOCK_STEP_DELAY_MS=80
SSE_HEARTBEAT_MS=15000

# Server-only OpenAI-compatible conversational Agent provider. Never expose the key to the browser.
OPENAI_API_KEY=REPLACE_IN_SECRET_MANAGER
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# LLM_API_KEY / LLM_BASE_URL / LLM_MODEL are accepted aliases for compatible providers.

# External integration policy
EXTERNAL_REQUEST_TIMEOUT_MS=5000
EXTERNAL_REQUEST_MAX_RETRIES=1

# Reserved for the future persistent repository
DATABASE_URL=postgresql://NARRAOPS_DB_USER:NARRAOPS_DB_PASSWORD@DB_HOST:5432/NARRAOPS_DB_NAME

# Supabase MVP authentication and persistence. The publishable key is safe for
# browser use when RLS is enabled. Never expose the secret/service-role key.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_PUBLISHABLE_KEY
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_PUBLISHABLE_KEY
# Server-only. Add to Vercel Production/Preview; never expose it to browser code.
SUPABASE_SECRET_KEY=REPLACE_WITH_SERVER_SECRET_KEY
SUPABASE_SECRET_KEY=REPLACE_IN_SERVER_SECRET_MANAGER

# Integration credentials are intentionally placeholders. Never commit real values.
X_API_BEARER_TOKEN=REPLACE_IN_SECRET_MANAGER
TIKTOK_API_TOKEN=REPLACE_IN_SECRET_MANAGER
INSTAGRAM_ACCESS_TOKEN=REPLACE_IN_SECRET_MANAGER
TELEGRAM_BOT_TOKEN=REPLACE_IN_SECRET_MANAGER
GMGN_API_KEY=REPLACE_IN_SECRET_MANAGER
GMGN_PRIVATE_KEY=REPLACE_IN_SECRET_MANAGER
GMGN_LIVE_ENABLED=true
GMGN_EXECUTION_ENABLED=true
GMGN_CLI_PATH=gmgn-cli
SOLANA_RPC_URL=REPLACE_IN_SECRET_MANAGER
BSC_RPC_URL=REPLACE_IN_SECRET_MANAGER
PUMP_METADATA_UPLOAD_URL=https://pump.fun/api/ipfs
PINATA_JWT=REPLACE_IN_SECRET_MANAGER
PINATA_GATEWAY_URL=https://gateway.pinata.cloud/ipfs
WALLET_VAULT_PASSWORD=REPLACE_WITH_AT_LEAST_16_RANDOM_CHARACTERS
WALLET_STORE_PATH=./data/wallet-vault.json
WALLET_GROUP_STORE_PATH=./data/wallet-groups.json
REAL_EXECUTION_ENABLED=true
LAUNCH_EXECUTION_STORE_PATH=./data/launch-executions.json
ROBINHOOD_RPC_URL=REPLACE_IN_SECRET_MANAGER
PONS_QUOTE_SERVICE_URL=REPLACE_WITH_REVIEWED_PROVIDER
BATCH_SIGNER_SERVICE_URL=REPLACE_WITH_ISOLATED_SIGNER
BATCH_SIGNER_AUTH_TOKEN=REPLACE_IN_SECRET_MANAGER

# Embedded-wallet provider boundary. Backend stores provider IDs/public addresses only.
PRIVY_APP_ID=REPLACE_WITH_PRIVY_APP_ID

JUPITER_API_BASE_URL=https://api.jup.ag/swap/v1
# Optional for higher Jupiter rate limits. Never expose this to the browser.
JUPITER_API_KEY=
AUTH_STORE_PATH=./data/web3-auth.json
APP_ORIGIN=http://127.0.0.1:5188
SECURE_COOKIES=false
