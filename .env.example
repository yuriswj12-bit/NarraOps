# API process (production should bind behind a reverse proxy)
API_HOST=127.0.0.1
API_PORT=5190
API_BODY_LIMIT_BYTES=1000000
LOG_LEVEL=info

# Async mock Agent and SSE
AGENT_MOCK_STEP_DELAY_MS=80
SSE_HEARTBEAT_MS=15000

# External integration policy
EXTERNAL_REQUEST_TIMEOUT_MS=5000
EXTERNAL_REQUEST_MAX_RETRIES=1

# Reserved for the future persistent repository
DATABASE_URL=postgresql://NARRAOPS_DB_USER:NARRAOPS_DB_PASSWORD@DB_HOST:5432/NARRAOPS_DB_NAME

# Integration credentials are intentionally placeholders. Never commit real values.
X_API_BEARER_TOKEN=REPLACE_IN_SECRET_MANAGER
TIKTOK_API_TOKEN=REPLACE_IN_SECRET_MANAGER
INSTAGRAM_ACCESS_TOKEN=REPLACE_IN_SECRET_MANAGER
TELEGRAM_BOT_TOKEN=REPLACE_IN_SECRET_MANAGER
GMGN_API_KEY=REPLACE_IN_SECRET_MANAGER
SOLANA_RPC_URL=REPLACE_IN_SECRET_MANAGER
BSC_RPC_URL=REPLACE_IN_SECRET_MANAGER
