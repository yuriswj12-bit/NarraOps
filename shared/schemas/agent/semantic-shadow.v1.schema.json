{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://narraops.com/schemas/agent/semantic-shadow.v1.schema.json",
  "title": "NarraOps Agent Semantic Shadow v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "shadowId",
    "actorId",
    "action",
    "resourceType",
    "resourceId",
    "envelope",
    "inspections",
    "shadowMode",
    "recordedAt"
  ],
  "properties": {
    "schemaVersion": { "const": "agent.semantic_shadow.v1" },
    "shadowId": { "type": "string", "format": "uuid" },
    "actorId": { "type": "string", "format": "uuid" },
    "action": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{2,100}$" },
    "resourceType": { "type": "string", "minLength": 1, "maxLength": 100 },
    "resourceId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "envelope": { "$ref": "execution-envelope.v1.schema.json" },
    "inspections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "transaction-inspection.v1.schema.json" }
    },
    "shadowMode": { "const": true },
    "recordedAt": { "type": "string", "format": "date-time" }
  }
}
