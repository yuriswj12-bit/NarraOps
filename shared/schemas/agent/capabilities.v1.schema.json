{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://narraops.com/schemas/agent/capabilities.v1.schema.json",
  "title": "NarraOps Agent Capabilities v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "agent",
    "skills",
    "published_financial_tools"
  ],
  "properties": {
    "schema_version": { "const": "agent.capabilities.v1" },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slug",
        "version",
        "name",
        "capabilities",
        "model_providers",
        "memory_enabled"
      ],
      "properties": {
        "slug": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
        "version": { "type": "integer", "minimum": 1 },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "description": { "type": "string", "maxLength": 2000 },
        "capabilities": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{2,100}$" }
        },
        "model_providers": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{1,63}$" }
        },
        "memory_enabled": { "type": "boolean" }
      }
    },
    "skills": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slug",
          "version",
          "name",
          "risk",
          "side_effect",
          "approval_policy",
          "required_permissions",
          "required_tools"
        ],
        "properties": {
          "slug": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
          "version": { "type": "integer", "minimum": 1 },
          "name": { "type": "string", "minLength": 1, "maxLength": 120 },
          "description": { "type": "string", "maxLength": 2000 },
          "risk": { "enum": ["read", "write_reversible", "financial_irreversible"] },
          "side_effect": { "enum": ["none", "internal_write", "external_write", "funds"] },
          "approval_policy": { "enum": ["none", "explicit", "explicit_and_recent_auth"] },
          "required_permissions": {
            "type": "array",
            "maxItems": 100,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 100 }
          },
          "required_tools": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "version"],
              "properties": {
                "name": { "type": "string", "minLength": 3, "maxLength": 100 },
                "version": { "type": "string", "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$" }
              }
            }
          }
        }
      }
    },
    "published_financial_tools": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version"],
        "properties": {
          "name": { "type": "string", "minLength": 3, "maxLength": 100 },
          "version": { "type": "string", "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$" }
        }
      }
    }
  }
}
