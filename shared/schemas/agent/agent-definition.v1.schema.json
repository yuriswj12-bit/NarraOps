{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://narraops.com/schemas/agent/agent-definition.v1.schema.json",
  "title": "NarraOps Agent Definition v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "agentId",
    "agentVersionId",
    "slug",
    "version",
    "name",
    "status",
    "systemInstructions",
    "capabilityManifest",
    "modelPolicy",
    "memoryPolicy",
    "checksum",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": { "const": "agent.definition.v1" },
    "agentId": { "type": "string", "format": "uuid" },
    "agentVersionId": { "type": "string", "format": "uuid" },
    "slug": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
    "version": { "type": "integer", "minimum": 1 },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "description": { "type": "string", "maxLength": 2000 },
    "status": { "enum": ["draft", "published", "retired"] },
    "systemInstructions": { "type": "string", "minLength": 1, "maxLength": 50000 },
    "capabilityManifest": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{2,100}$" }
    },
    "modelPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowedProviders"],
      "properties": {
        "allowedProviders": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{1,63}$" }
        },
        "defaultProvider": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{1,63}$" },
        "parameters": { "type": "object" }
      }
    },
    "memoryPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "allowedScopes", "retrievalLimit", "requireUserConfirmation"],
      "properties": {
        "enabled": { "type": "boolean" },
        "allowedScopes": {
          "type": "array",
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "enum": ["user", "conversation", "task"] }
        },
        "retrievalLimit": { "type": "integer", "minimum": 0, "maximum": 50 },
        "requireUserConfirmation": { "type": "boolean" }
      }
    },
    "checksum": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "createdAt": { "type": "string", "format": "date-time" },
    "publishedAt": { "type": "string", "format": "date-time" }
  }
}
