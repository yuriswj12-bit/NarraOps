{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://narraops.com/schemas/agent/execution-intent.v1.schema.json",
  "title": "NarraOps Agent Execution Intent v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "intentId",
    "actorId",
    "action",
    "resourceType",
    "resourceId",
    "parameters",
    "intentDigest",
    "risk",
    "status",
    "createdAt",
    "expiresAt"
  ],
  "properties": {
    "schemaVersion": { "const": "agent.execution_intent.v1" },
    "intentId": { "type": "string", "format": "uuid" },
    "actorId": { "type": "string", "format": "uuid" },
    "action": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{2,100}$" },
    "resourceType": { "type": "string", "minLength": 1, "maxLength": 100 },
    "resourceId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "parameters": { "type": "object" },
    "intentDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "risk": { "const": "financial_irreversible" },
    "status": {
      "enum": ["requested", "approved", "rejected", "consumed", "expired"]
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" }
  }
}
