{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://narraops.com/schemas/agent/message-request.v2.schema.json",
  "title": "NarraOps Agent Message Request v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["message"],
  "properties": {
    "message": { "type": "string", "minLength": 1, "maxLength": 8000 },
    "command": { "type": "string", "maxLength": 200 },
    "channel": { "enum": ["web", "telegram", "api"] },
    "wait": { "type": "boolean", "default": true },
    "timeout_ms": { "type": "integer", "minimum": 250, "maximum": 30000 },
    "timeoutMs": { "type": "integer", "minimum": 250, "maximum": 30000 },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "language": { "enum": ["zh", "en"] },
        "currentView": { "type": "string", "minLength": 1, "maxLength": 50 },
        "projectId": { "type": "string", "maxLength": 100 },
        "contextRefs": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "id"],
            "properties": {
              "kind": {
                "enum": [
                  "pulse.narrative_snapshot",
                  "pulse.opportunity",
                  "assets.wallet_group",
                  "assets.wallet",
                  "agent.artifact"
                ]
              },
              "id": { "type": "string", "minLength": 1, "maxLength": 256 },
              "version": { "type": "string", "maxLength": 128 },
              "digest": { "type": "string", "maxLength": 256 }
            }
          }
        }
      }
    }
  }
}
