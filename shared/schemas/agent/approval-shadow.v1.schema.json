{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://narraops.com/schemas/agent/approval-shadow.v1.schema.json",
  "title": "NarraOps Agent Approval Shadow Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "approvalId",
    "intent",
    "actorId",
    "status",
    "legacyConfirmationKind",
    "recordedAt"
  ],
  "properties": {
    "schemaVersion": { "const": "agent.approval_shadow.v1" },
    "approvalId": { "type": "string", "format": "uuid" },
    "intent": {
      "$ref": "execution-intent.v1.schema.json"
    },
    "actorId": { "type": "string", "format": "uuid" },
    "status": {
      "enum": ["requested", "approved", "rejected", "consumed", "expired"]
    },
    "legacyConfirmationKind": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "legacyRequestId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "recordedAt": { "type": "string", "format": "date-time" }
  }
}
