{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://narraops.com/schemas/narrative-evidence.schema.json",
  "title": "Narrative Evidence",
  "type": "object",
  "required": ["evidenceId", "sourceType", "url", "publisher", "publishedAt", "capturedAt", "status"],
  "properties": {
    "evidenceId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "sourceType": { "enum": ["rss", "web", "x", "reddit", "youtube", "instagram", "tiktok", "onchain", "other"] },
    "url": { "type": "string", "format": "uri", "maxLength": 2048 },
    "publisher": { "type": "string", "minLength": 1, "maxLength": 256 },
    "title": { "type": ["string", "null"], "maxLength": 512 },
    "excerpt": { "type": ["string", "null"], "maxLength": 2000 },
    "publishedAt": { "type": ["string", "null"], "format": "date-time" },
    "capturedAt": { "type": "string", "format": "date-time" },
    "status": { "enum": ["available", "dynamic_render_required", "unavailable", "unverified"] }
  },
  "additionalProperties": false
}
