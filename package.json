{
  "name": "narraops-product",
  "version": "0.1.0",
  "private": true,
  "description": "NarraOps AI-native narrative discovery workspace",
  "scripts": {
    "build:frontend": "esbuild frontend/src/app.ts --bundle --format=iife --platform=browser --target=es2022 --outfile=app.js",
    "build:vercel": "npm run build:frontend && node scripts/deploy/prepare-vercel-static.mjs",
    "start": "npm run build:frontend && powershell -ExecutionPolicy Bypass -File scripts/start-narraops.ps1",
    "start:frontend": "npm run build:frontend && node server.js",
    "start:api": "npm --prefix backend/api start",
    "build:api": "esbuild backend/api/src/server.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist/backend-api/server.mjs",
    "typecheck": "tsc -p shared/tsconfig.json && tsc -p frontend/tsconfig.json && tsc -p backend/api/tsconfig.json",
    "check": "npm run build:frontend && npm run build:api && node --check app.js && node --check server.js",
    "test:api": "npm --prefix backend/api test",
    "test:execution": "node --import tsx --test backend/execution/test/*.test.ts"
  },
  "dependencies": {
    "@four-meme/four-meme-ai": "^1.0.8",
    "@pump-fun/pump-sdk": "^1.36.0",
    "@solana/web3.js": "^1.98.4",
    "bs58": "^6.0.0",
    "ethers": "^6.15.0",
    "tweetnacl": "^1.0.3",
    "ws": "^8.21.0"
  },
  "overrides": {
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  }
}
