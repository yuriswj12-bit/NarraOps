{
  "name": "narraops-product",
  "version": "0.1.0",
  "private": true,
  "description": "NarraOps AI-native narrative discovery workspace",
  "scripts": {
    "start": "powershell -ExecutionPolicy Bypass -File scripts/start-narraops.ps1",
    "start:frontend": "node server.js",
    "start:api": "powershell -ExecutionPolicy Bypass -Command \"Set-Location backend/api; node --env-file-if-exists=../../.env src/server.mjs\"",
    "typecheck": "tsc -p shared/tsconfig.json",
    "check": "node --check app.js && node --check server.js && node --check backend/execution/service.js",
    "test:execution": "node --test backend/execution/test/*.test.js"
  },
  "dependencies": {
    "@four-meme/four-meme-ai": "^1.0.8",
    "@pump-fun/pump-sdk": "^1.36.0",
    "@solana/web3.js": "^1.98.4",
    "bs58": "^6.0.0",
    "ethers": "^6.15.0",
    "tweetnacl": "^1.0.3",
    "ws": "^8.21.0"
  },
  "overrides": {
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
