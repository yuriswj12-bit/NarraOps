# Replace the domain names before copying this file to /etc/caddy/Caddyfile.
narraops.example.com, www.narraops.example.com {
  encode zstd gzip

  header {
    X-Content-Type-Options nosniff
    X-Frame-Options DENY
    Referrer-Policy strict-origin-when-cross-origin
  }

  reverse_proxy 127.0.0.1:8080
}
