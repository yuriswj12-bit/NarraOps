{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist/vercel"
      }
    },
    {
      "src": "api/v1/**/*.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "backend/integrations/gmgn-execution-adapter.ts",
          "node_modules/gmgn-cli/**",
          "node_modules/commander/**",
          "node_modules/dotenv/**",
          "node_modules/socks/**",
          "node_modules/smart-buffer/**",
          "node_modules/ip-address/**",
          "node_modules/undici/**"
        ]
      }
    }
  ],
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "routes": [
    {
      "src": "/api/v1/agent/(.*)",
      "dest": "/api/v1/[...path].ts"
    },
    {
      "src": "/api/v1/go/launch-drafts/([^/]+)",
      "dest": "/api/v1/[...path].ts"
    },
    {
      "src": "/api/v1/launch/drafts/([^/]+)",
      "dest": "/api/v1/[...path].ts"
    },
    {
      "src": "/api/v1/telegram/webhook",
      "dest": "/api/v1/[...path].ts"
    },
    {
      "src": "/api/v1/wallet-groups/([^/]+)/wallets",
      "dest": "/api/v1/wallet-groups/[groupId]/wallets.ts"
    },
    {
      "src": "/api/v1/(.*)",
      "dest": "/api/v1/$1.ts"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/app",
      "dest": "/app.html"
    }
  ]
}
