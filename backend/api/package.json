{
  "name": "@narraops/backend-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node --import tsx --env-file-if-exists=../../.env src/server.ts",
    "dev": "node --import tsx --env-file-if-exists=../../.env --watch src/server.ts",
    "check": "tsc -p tsconfig.json",
    "test": "node --import tsx --test tests/*.test.ts"
  }
}
